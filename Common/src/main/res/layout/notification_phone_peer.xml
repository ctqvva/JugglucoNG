<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/notification_peer_group"
 android:layout_width="wrap_content" android:layout_height="wrap_content"
 android:orientation="horizontal" android:gravity="center_vertical">
 <TextView android:id="@+id/notification_peer_value"
  android:layout_width="wrap_content" android:layout_height="wrap_content"
  android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
  android:includeFontPadding="false" android:maxLines="1" />
 <ImageView android:id="@+id/notification_peer_image"
  android:layout_width="wrap_content" android:layout_height="wrap_content"
  android:adjustViewBounds="true" android:scaleType="fitCenter" android:visibility="gone" />
 <ImageView android:id="@+id/notification_peer_arrow"
  android:layout_width="wrap_content" android:layout_height="wrap_content"
  android:adjustViewBounds="true" android:scaleType="fitCenter" />
</LinearLayout>
