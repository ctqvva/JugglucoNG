<?xml version="1.0" encoding="utf-8"?>
<!-- Native phone value row, medium (500) IBM Plex variant. textStyle bold keeps
     the preference visible on APIs where the variable 'wght' axis cannot be set
     remotely; API 35+ additionally receives the exact variation string. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/notification_value_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/notif_font_medium"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:text=""
        android:textSize="24sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/notification_value_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:visibility="gone" />

</LinearLayout>
