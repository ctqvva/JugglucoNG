<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingBottom="4dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/notification_glucose"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
            android:includeFontPadding="false" android:maxLines="1" />
        <ImageView android:id="@+id/notification_glucose_image"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:adjustViewBounds="true" android:scaleType="fitCenter" android:visibility="gone" />
        <ImageView android:id="@+id/notification_arrow"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" android:visibility="gone" />
        <LinearLayout android:id="@+id/notification_peers"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" />
    </LinearLayout>
    <TextView android:id="@+id/notification_status"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Info"
        android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end"
        android:textSize="12sp" android:visibility="gone" />
    <ImageView android:id="@+id/notification_status_image"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:adjustViewBounds="true" android:scaleType="fitStart" android:visibility="gone" />
    <FrameLayout android:id="@+id/chart_container"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:visibility="gone">
        <ImageView android:id="@+id/notification_chart"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:adjustViewBounds="true" android:scaleType="fitCenter"
            android:contentDescription="@string/notification_chart_accessibility" />
    </FrameLayout>
</LinearLayout>
