-keep class androidx.wear.watchface.complications.rendering.ComplicationDrawable

# AGP 9 enables R8 full mode. ML Kit 17.3.0/18.3.1 discovers its registrars through manifest
# metadata, but its consumer rules do not preserve the complete runtime component graph under
# full-mode optimization. The release build then keeps MlKitInitProvider and BarcodeRegistrar
# while BarcodeScanning.getClient() receives a null barcode factory and crashes. Keep ML Kit's
# dynamically registered components until the upstream artifacts provide full-mode-safe rules.
-keep class com.google.mlkit.** { *; }

# Keep AiDex vendor bridge classes/fields/methods used by libblecomm-lib JNI.
-keep class com.microtechmd.blecomm.** { *; }

# Keep HistorySync/HistoryRepository names and reflected members stable.
# HistorySyncAccess in src/main resolves these mobile-only classes by name.
# This list is a duplicate of the getMethod() names in HistorySyncAccess, and nothing checks
# that the two agree. They did not: getHistoryTimestampsForSensorBlocking was missing here, so
# in every minified build the lookup threw, the bridge answered "no rows", and the Ottai driver
# read that as "nothing stored" and re-pulled the sensor's whole history on every reconnect --
# silently, because tk.glucodata.Log is stripped by proguard-rules.log. The members below now
# also carry @Keep at their declaration, which cannot drift; keep both in sync when adding one.
-keepnames class tk.glucodata.data.HistoryRepository
-keepclassmembers class tk.glucodata.data.HistoryRepository {
    public static void resetBackfillFlag();
    public static java.util.List getHistoryForNotificationForSensor(java.lang.String,long,boolean);
    public static long getLatestTimestampForSensorBlocking(java.lang.String);
    public static long[] getHistoryTimestampsForSensorBlocking(java.lang.String,long,long);
    public static int deleteReadingsForSensorAfterBlocking(java.lang.String,long);
    public static void storeReadingAsync(long,float,int);
    public static void storeReadingAsync(long,float,float,float);
    public static void storeReadingAsync(long,float,float,float,java.lang.String);
    public static void storeHistoryBatchAsync(java.lang.String,long[],float[],float[]);
    public static boolean storeHistoryBatchBlocking(java.lang.String,long[],float[],float[]);
}

-keepnames class tk.glucodata.data.HistorySync
-keepclassmembers class tk.glucodata.data.HistorySync {
    public static final tk.glucodata.data.HistorySync INSTANCE;
    public final void syncSensorFromNative(java.lang.String,boolean);
    public final void syncRecentSensorFromNative(java.lang.String,long);
    public final void forceFullSyncForSensor(java.lang.String);
    public final void mergeFullSyncForSensor(java.lang.String);
    public final void markSensorReset(java.lang.String);
}

# Keep GlucoseUncertaintyStore names and reflected members stable.
# GlucoseUncertaintyAccess in src/main resolves this mobile-only class by name, and the same
# failure mode as HistoryRepository above applies: without these rules the lookup throws only
# in minified builds, the bridge silently stores nothing, and every chart renders without its
# uncertainty ribbon with no error anywhere. The members also carry @Keep at their declaration;
# keep both in sync when adding one.
-keepnames class tk.glucodata.data.GlucoseUncertaintyStore
-keepclassmembers class tk.glucodata.data.GlucoseUncertaintyStore {
    public static final tk.glucodata.data.GlucoseUncertaintyStore INSTANCE;
    public static void storeBatch(java.lang.String,long[],float[],float[],float,float[],float[]);
    public static void storeReading(java.lang.String,long,float,float,float,float,float);
    public static void clearForSensor(java.lang.String);
    public static void deleteForSensorAfter(java.lang.String,long);
    public static void pruneOlderThan(long);
}

# Keep the hidden-framework connection-parameter callback.
# BluetoothGattCallback#onConnectionUpdated exists since Android O but is absent from the SDK
# stubs, so SuperGattCallback declares it without @Override and nothing in the compiled code
# ever calls it -- the platform binds it at runtime by name+descriptor. R8 sees an unreachable
# method and does not rename it but DELETES it: no shipped mapping.txt has ever contained
# onConnectionUpdated, and in the 2026-08-01 jamming storm the framework invoked it 210/207
# times into the two running apps while the app logged zero "conn params" lines. Same failure
# class as the HistoryRepository note above -- dispatch by name that R8 cannot see -- and the
# same silence: with the method gone the link-parameter history of an outage exists nowhere.
# The declaration also carries @Keep, which cannot drift; keep both in sync.
-keepclassmembers class * extends android.bluetooth.BluetoothGattCallback {
    public void onConnectionUpdated(android.bluetooth.BluetoothGatt, int, int, int, int);
}

# Keep CalibrationManager names and reflected members stable.
# JournalAccess in src/main resolves this mobile-only facade by name. Without
# these the watch journal silently does nothing in minified builds.
-keepnames class tk.glucodata.data.journal.WearJournalBridge
-keepclassmembers class tk.glucodata.data.journal.WearJournalBridge {
    public static final tk.glucodata.data.journal.WearJournalBridge INSTANCE;
    public final byte[] serveEntries(long);
    public final boolean applyCommand(byte[]);
    public final boolean isJournalEnabled();
}

# CalibrationAccess in src/main resolves these mobile-only methods by name.
-keepnames class tk.glucodata.data.calibration.CalibrationManager
-keepclassmembers class tk.glucodata.data.calibration.CalibrationManager {
    public static final tk.glucodata.data.calibration.CalibrationManager INSTANCE;
    public final boolean hasActiveCalibration(boolean,java.lang.String);
    public final float getCalibratedValue(float,long,boolean,boolean,java.lang.String);
    public final boolean shouldHideInitialWhenCalibrated();
    public final boolean shouldOverwriteSensorValues();
    public final long getRevision();
    public static void notifyExternalCalibrationPipelineChanged();
    public static double[] getActiveCalibrationAnchors(java.lang.String,boolean);
    public static double[] getIntegratedCalibrationAnchors(java.lang.String,boolean);
    public final tk.glucodata.data.calibration.CalibrationTuning tuningForMode(boolean);
    public static boolean isCalibrationStateLoaded();
    public static float[] getIntegratedCalibratedSeries(float[],long[],boolean,java.lang.String);
    public static long getIntegratedCalibrationFingerprint(java.lang.String,boolean);
    public static void seedIntegratedCalibrationBaseline(float[],long[],boolean,java.lang.String);
    public final java.lang.String exportProfileForSensorAsJson(java.lang.String);
    public final *** importProfileFromJsonBlocking(java.lang.String,boolean,java.lang.String);
    public final *** importMirrorProfileFromJsonBlocking(java.lang.String,java.lang.String);
    # The mutations WearCalibrationCommand relays from the watch. These have no
    # non-reflective caller under their exact name, so R8 renamed
    # setEnabledForMode and deleted the four *Blocking methods outright: every
    # calibration action taken on the watch logged "applied=false" in release
    # builds while working in debug.
    public final void setEnabledForMode(boolean,boolean,java.lang.String);
    public final boolean addCalibrationFromWearAtBlocking(long,float,float);
    public final boolean deleteCalibrationAtBlocking(long);
    public final boolean updateCalibrationUserValueBlocking(long,float);
    public final void clearAllBlocking();
}

-keep class tk.glucodata.CalibrationProfileAccess { *; }

# Keep the native exported-value bridge stable. uploader.cpp and common.cpp resolve
# these by GetStaticMethodID, which R8 cannot see as a reference: without them the
# Nightscout uploader and the webserver silently fall back to unsmoothed,
# uncalibrated stored values in minified builds only. The declarations also carry
# @Keep; keep the two in sync.
-keep class tk.glucodata.NightscoutCalibration { *; }

# Keep notification/AOD predictive chart bridge stable. NotificationChartDrawer
# resolves the mobile-only helper by name so main/wear source sets do not take a
# direct dependency on mobile prediction/journal classes.
-keep class tk.glucodata.NotificationPredictionOverlay { *; }
-keep class tk.glucodata.NotificationPredictionPoint { *; }
-keep class tk.glucodata.NotificationPredictionSeries { *; }

# Keep TrendEngine names and reflected members stable.
# TrendAccess in src/main resolves these mobile-only methods by name for
# notification/dashboard/AOD trend arrows in minified builds.
-keepnames class tk.glucodata.logic.TrendEngine
-keepclassmembers class tk.glucodata.logic.TrendEngine {
    public static final tk.glucodata.logic.TrendEngine INSTANCE;
    public final tk.glucodata.logic.TrendEngine$TrendResult calculateTrend(java.util.List,boolean,boolean);
}

-keepnames class tk.glucodata.logic.TrendEngine$TrendResult
-keepclassmembers class tk.glucodata.logic.TrendEngine$TrendResult {
    public final float getVelocity();
}

# Keep OutboundApiJournalSnapshot name and reflected members stable.
# OutboundApi, ApiGlucoseSourceManager and JugglucoSend (src/main) resolve this
# mobile-only object by name: snapshotJson() backs the {iob}/{cob}/{journal}/
# {journal_events} message-template tokens, importFromJson*() ingests API
# journal payloads, and broadcastIobSnapshot() feeds the glucodata.Minute
# IOB/eIOB/COB extras. Without this, R8 renames/strips the class and the
# reflection silently yields an empty snapshot (tokens render as
# "0 - 0 - 0 - 0 -  -") / a broadcast without IOB.
-keepnames class tk.glucodata.OutboundApiJournalSnapshot
-keepclassmembers class tk.glucodata.OutboundApiJournalSnapshot {
    public static java.lang.String snapshotJson(long);
    public static int importFromJson(java.lang.String);
    public static int importFromJsonForSource(java.lang.String,java.lang.String);
    public static float[] broadcastIobSnapshot(long);
}

#-keep class tk.glucodata.watchface.WatchFaceService
#-keep class tk.glucodata.watchface.WatchFaceService.editor.WatchFaceConfigActivity

-whyareyoukeeping class com.google.firebase.*
-whyareyoukeeping class com.google.android.gms.auth.api.signin.*
-whyareyoukeeping class com.google.android.gms.dynamite.*

-renamesourcefileattribute SourceFile
-keepattributes SourceFile,LineNumberTable
-printmapping printmappingout.txt

# Anytime / Yuwell native algorithm JNI uses reflection/GetMethodID on these classes.
# Do not obfuscate or strip class names, fields, constructors, or accessors.
-keep class ist.com.sdk.** { *; }
-keepclassmembers class ist.com.sdk.** { *; }
-keepnames class ist.com.sdk.**

# If any SDK models are in com.sdk instead of ist.com.sdk in this build:
-keep class com.sdk.** { *; }
-keepclassmembers class com.sdk.** { *; }
-keepnames class com.sdk.**

# In-app updater. WorkManager instantiates the worker by class name and the PackageInstaller
# status PendingIntent resolves the receiver by component, neither of which R8 can see as a
# reference. Both also carry @Keep at their declaration; keep the two in sync.
-keep class tk.glucodata.update.AppUpdateCheckWorker { public <init>(...); }
-keep class tk.glucodata.update.AppUpdateInstallReceiver { public <init>(...); }

# Keep the Compose UI entry point stable. MainActivity resolves
# tk.glucodata.ui.ComposeHostKt#setComposeContent by name (mobile and wear each
# provide their own implementation); without this the reflective lookup fails
# only in minified builds and the app silently falls back to the legacy View UI.
-keep class tk.glucodata.ui.ComposeHostKt {
    public static void setComposeContent(androidx.appcompat.app.AppCompatActivity, android.view.View);
}
